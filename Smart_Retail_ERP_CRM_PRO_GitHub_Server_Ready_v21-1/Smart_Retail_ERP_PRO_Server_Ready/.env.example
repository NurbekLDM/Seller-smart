# Copy to .env. Never commit .env or use the example password in production.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
HOST_PORT=8080

# Set this to your real HTTPS address and domain before public deployment.
APP_ORIGIN=https://erp.example.uz
APP_DOMAIN=erp.example.uz
TENANT_ID=main_store

# Use at least 16 random characters. Example generation:
# openssl rand -base64 32
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# HTTPS deployment requires secure cookies. Set 0 only for local HTTP testing.
SECURE_COOKIES=1
TRUST_PROXY=1
SESSION_HOURS=12
MAX_BODY_BYTES=20971520
DATABASE_PATH=./data/smart-retail.sqlite
