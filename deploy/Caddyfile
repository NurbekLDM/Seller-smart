# One origin for everything: the app and the Supabase API share the domain,
# so the browser needs no CORS and the CSP's 'self' covers the API.
# Caddy obtains and renews the TLS certificate for APP_DOMAIN by itself
# (the domain's A record must point at this server, ports 80/443 open).
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	# Only the three Supabase APIs the app uses. Studio, Storage, Functions
	# and the rest of the gateway are not reachable from the internet.
	@supabase path /auth/v1/* /rest/v1/* /realtime/v1/*
	handle @supabase {
		reverse_proxy api-gw:8000
	}

	handle {
		reverse_proxy app:3000
	}

	header -server
}

# www.<domain> → <domain>, so nobody keeps writing to an old copy of the site.
# Needs a DNS A record (www.<domain> → this server).
www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

# SellerSmart ERP 119.3 with server storage (server/erp119.mjs,
# erp119/sync.js, supabase/2026-11-27-erp119-kv.sql). On its own origin on
# purpose: on sellersmart.uz it would share localStorage/IndexedDB keys with
# the live ERP. Users sign in with their SellerSmart account; the Supabase
# API is proxied here too, so the page talks to it same-origin.
# Needs a DNS A record (erp.<domain> → this server).
erp.{$APP_DOMAIN} {
	encode zstd gzip

	@supabase path /auth/v1/* /rest/v1/* /realtime/v1/*
	handle @supabase {
		reverse_proxy api-gw:8000
	}

	handle {
		reverse_proxy app:3000
	}

	header -server
}

# Kartochka Studio. Needs its own DNS A record (kartochka.<domain> → this
# server). Only for SellerSmart accounts that have the "kartochka" service
# (set on /admin): every request is checked by the app (server/services.mjs:
# signed sr-svc cookie + the grant, re-checked each minute); without access
# the visitor goes to https://<domain>/app.html, which renews it and returns.
kartochka.{$APP_DOMAIN} {
	encode zstd gzip
	forward_auth app:3000 {
		uri /api/gate/check?service=kartochka
	}
	reverse_proxy kartochka:8765 {
		# The studio answers POSTs that run several minutes (image generation).
		transport http {
			read_timeout 6m
			write_timeout 6m
		}
	}
	header -server
}
